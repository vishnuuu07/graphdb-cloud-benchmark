# Copy to .env or set these values in the process environment. Never commit .env.
COGNODB_URI=bolt+s://your-instance.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=replace-me

# Docker Compose uses this same password to initialize the local Neo4j instance.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=replace-me-with-a-password-at-least-8-characters

# Local Memgraph is unauthenticated by default; override only if its deployment enables auth.
MEMGRAPH_URI=bolt://localhost:7688
MEMGRAPH_USER=
MEMGRAPH_PASSWORD=

# Local FalkorDB defaults to Redis port 6379. Set a password only if ACL auth is enabled.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Docker Compose initializes ArangoDB from this password.
ARANGODB_URL=http://localhost:8529
ARANGODB_USER=root
ARANGODB_PASSWORD=replace-me-with-a-password
